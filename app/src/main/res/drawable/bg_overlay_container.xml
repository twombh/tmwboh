<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 배경색: rgba(44, 44, 44, 0.8) -->
    <solid android:color="#CC2C2C2C" />

    <!-- 모서리  -->
    <corners android:radius="99dp" />

    <!-- 테두리: rgba(145, 145, 145, 0.5) -->
    <stroke
        android:width="1dp"
        android:color="#80919191" />

    <!-- ARGB 변환표

        FF = 100%

        F2 = 95%

        E6 = 90%

        D9 = 85%

        CC = 80%

        BF = 75%

        B3 = 70%

        А6 = 65%

        99 = 60%

        8C = 55%

        80 = 50%

        73 = 45%

        66 = 40%

        59 = 35%

        4D = 30%

        40 = 25%

        33 = 20%

        26 = 15%

        1A = 10%

        0D = 5%

        00 = 0%
    -->
</shape>