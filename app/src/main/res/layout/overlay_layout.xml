<?xml version="1.0" encoding="utf-8"?>
<!-- 전체(컨텐츠 영역): 동적 크기로 변경 (코드에서 제어) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_vertical|start"
    android:background="#FFFFFF">

    <!-- gap: 12px를 위한 상단 여백 (동적 크기) -->
    <Space
        android:id="@+id/topSpace"
        android:layout_width="match_parent"
        android:layout_height="6dp" />

    <!-- 이미지+텍스트 영역: flex, align-items: center, gap: 16px -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 이미지(로고): 동적 크기 (코드에서 제어) -->
        <ImageView
            android:id="@+id/logoView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginRight="16dp"
            android:src="@drawable/tmoneyapp"
            android:background="#4CAF50" />

        <!-- 텍스트 영역: flex-direction: column, justify-content: center, align-items: flex-start, gap: 2px -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical|start">

            <!-- 따릉이 대여중 텍스트: flex, align-items: center, gap: 4px -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 따릉이 텍스트: font-weight: 400, letter-spacing: -0.22px -->
                <TextView
                    android:id="@+id/ddareungiText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="따릉이"
                    android:textColor="#111111"
                    android:textSize="22sp"
                    android:textStyle="normal"
                    android:lineHeight="30dp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="sans-serif" />

                <!-- gap: 4px (동적 크기) -->
                <Space
                    android:id="@+id/middleSpace"
                    android:layout_width="4dp"
                    android:layout_height="wrap_content" />

                <!-- 대여중 텍스트: font-weight: 700, letter-spacing: -0.22px -->
                <TextView
                    android:id="@+id/daeyeojungText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="대여중"
                    android:textColor="#111111"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:lineHeight="30dp"
                    android:letterSpacing="-0.01"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <!-- gap: 2px (동적 크기) -->
            <Space
                android:id="@+id/bottomSpace"
                android:layout_width="match_parent"
                android:layout_height="2dp" />

            <!-- 반납을 꼭 확인해주세요 텍스트: letter-spacing: -0.08px -->
            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="반납을 꼭 확인해주세요"
                android:textColor="#888888"
                android:textSize="16sp"
                android:textStyle="normal"
                android:lineHeight="22dp"
                android:letterSpacing="-0.005"
                android:fontFamily="sans-serif" />

        </LinearLayout>

    </LinearLayout>

    <!-- gap: 12px를 위한 하단 여백 (동적 크기) -->
    <Space
        android:id="@+id/bottomSpaceMain"
        android:layout_width="match_parent"
        android:layout_height="6dp" />

</LinearLayout> 